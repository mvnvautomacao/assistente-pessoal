# --- Evolution API (WhatsApp) ---
# Local: http://localhost:8080 (docker-compose.yml). Producao: URL do servico no Coolify.
EVOLUTION_API_URL=http://localhost:8085
# Escolha uma string aleatoria; e o mesmo valor usado no docker-compose.yml
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=assistente-pessoal
# Seu numero de WhatsApp (com codigo do pais, sem +), para onde vao os lembretes
MY_WHATSAPP_NUMBER=5511999999999

# --- Anthropic (interpretar mensagens: texto, audio transcrito e imagens de recibo) ---
ANTHROPIC_API_KEY=

# --- Groq (transcricao de audio via Whisper, tem tier gratuito) ---
GROQ_API_KEY=

# --- Google (Calendar) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# gerado uma unica vez rodando "npm run google:token"
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- App ---
PORT=3000
# em producao (Coolify), aponte isso para dentro do volume persistente, ex: /app/data/data.sqlite.
# O Dockerfile ja define /app/data/data.sqlite como padrao; o volume em si (Storages -> /app/data) voce cria no Coolify.
# Na subida o sistema confere se essa pasta e um volume persistente e avisa no /admin e por WhatsApp se nao for.
DB_PATH=./data/data.sqlite
# opcional, mas recomendado antes de expor o servidor publicamente: uma string
# aleatoria. Se definida, o /webhook so aceita chamadas com "?secret=" igual a
# esse valor -- registre a URL com o segredo via
# "npm run evolution:webhook -- https://sua-url/webhook?secret=SEU_SEGREDO"
WEBHOOK_SECRET=

# Por quantos dias o log de atividade (aba "Atividade recente" do /admin) e guardado. Padrao: 90. Todo dia as 3h uma rotina
# apaga o que passou disso (inclusive tentativas bloqueadas e quedas). 0 = nunca apagar. Valor invalido = 90.
ACTIVITY_LOG_RETENTION_DAYS=90

# Resposta livre ou falada a uma pergunta com opcoes ("ja paguei a conta hoje"): o bot SEMPRE repete o que entendeu ("Entendi que foi *1*. Confirma?")
# antes de aplicar. Com "true", so a interpretacao "ja paguei" do aviso de conta fixa segue direto pra pergunta do valor (repetindo o que entendeu).
AUTO_APPLY_INTERPRETED_PAID=false

# --- Login do /admin (obrigatorio -- o app nao sobe sem essas duas) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Coolify (redeploy automatico via "npm run deploy") ---
# URL em Settings > Advanced > Webhooks > Deploy webhook, na tela do servico no Coolify
COOLIFY_DEPLOY_WEBHOOK_URL=
# gerado em Keys & Tokens > API Tokens (precisa habilitar "API access" em Settings > Advanced antes) -- permissao "Deploy"
COOLIFY_API_TOKEN=
